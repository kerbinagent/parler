            "command": "\"/ABSOLUTE/PATH/TO/node\" \"/ABSOLUTE/PATH/TO/parler/bin/parler-hook.mjs\" --client claude-code --state \"/ABSOLUTE/PATH/TO/private-parler-state\"",
            "timeout": 3
          }
